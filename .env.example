# Entorno
ENV=development
LOG_LEVEL=INFO

# Base de datos PostgreSQL
DATABASE_URL=postgresql+asyncpg://tbot_user:tbot_password@localhost:5432/tbot_db
# URL para Alembic / conexiones síncronas (opcional / utilitaria)
DATABASE_SYNC_URL=postgresql://tbot_user:tbot_password@localhost:5432/tbot_db

# Alpaca Trading & Market Data API
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
LIVE_TRADING_ENABLED=false

# LLM Providers (Veto IA)
GEMINI_API_KEY=
GROQ_API_KEY=

# Datos de mercado adicionales
FINNHUB_API_KEY=

# Notificaciones y alertas (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# Seguridad y Aprobaciones
APPROVAL_HMAC_SECRET=cambiar_por_un_secreto_seguro_hex_o_aleatorio
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_POLICY_AUD=
BYPASS_CLOUDFLARE_AUTH_LOCAL=true

# Monitoreo
HEALTHCHECKS_PING_URL=
